{
  "name": "quick-pay",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "deploy:start": "tsx scripts/start-deployment.ts",
    "deploy:verify": "tsx scripts/verify-deployment.ts",
    "config:check": "tsx scripts/check-config.ts",
    "qa:serve": "tsx scripts/serve-qa.ts",
    "brand:sync": "tsx scripts/sync-brand.ts",
    "brand:sync:mobile": "tsx scripts/sync-mobile-brand.ts",
    "mobile:dev": "pnpm --filter @quickpay/mobile start",
    "mobile:android": "pnpm --filter @quickpay/mobile android",
    "mobile:ios": "pnpm --filter @quickpay/mobile ios",
    "mobile:typecheck": "pnpm --filter @quickpay/mobile typecheck",
    "mobile:export": "pnpm --filter @quickpay/mobile export",
    "mobile:doctor": "pnpm --filter @quickpay/mobile doctor",
    "dev": "tsx scripts/start-local.ts",
    "worker": "tsx watch apps/worker/src/index.ts",
    "build": "pnpm --filter @quickpay/api build && pnpm --filter @quickpay/web build",
    "typecheck": "tsc --noEmit && pnpm mobile:typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "admin:grant": "tsx scripts/grant-local-admin.ts",
    "worker:start": "tsx apps/worker/src/index.ts",
    "start": "pnpm --parallel --filter @quickpay/web --filter @quickpay/api start"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "dotenv": "18.0.9",
    "better-auth": "1.7.16",
    "pg": "8.20.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.19.0"
  }
}
