{
  "name": "@quickpay/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "brand:sync": "tsx ../../scripts/sync-mobile-brand.ts",
    "start": "pnpm brand:sync && expo start --dev-client",
    "android": "pnpm brand:sync && expo run:android",
    "ios": "pnpm brand:sync && expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "pnpm brand:sync && expo export --platform all",
    "config:check": "expo config --type public",
    "doctor": "pnpm dlx expo-doctor"
  },
  "dependencies": {
    "@quickpay/contracts": "workspace:*",
    "@quickpay/api-client": "workspace:*",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-router": "~57.0.29",
    "nativewind": "4.2.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "tailwindcss": "~3.4.17",
    "typescript": "5.9.3"
  }
}
