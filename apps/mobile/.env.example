# Public configuration only. Never add provider or database credentials here.
# Android emulator: http://10.0.2.2:3001/api/v1
# Physical devices: LAN IP of your computer, e.g. http://192.168.1.20:3001/api/v1
# HTTPS is mandatory outside local development.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
EXPO_PUBLIC_SITE_URL=http://192.168.1.20:3000
# Optional EAS project UUID; push remains unavailable without this and server setup.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Native build configuration. Example identifiers are development-only.
APP_VARIANT=development
APP_LINK_HOST=
APP_IOS_BUNDLE_ID=
APP_ANDROID_PACKAGE=
